{
    "name": "neetcode/core",
    "description": "Pure, framework-free NeetCode algorithms in PHP. No Laravel, no HTTP.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "NeetCode\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeetCode\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
