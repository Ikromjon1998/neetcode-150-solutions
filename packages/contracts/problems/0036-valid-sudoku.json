{
  "$schema": "../schema/problem-contract.schema.json",
  "id": 36,
  "slug": "valid-sudoku",
  "title": "Valid Sudoku",
  "difficulty": "medium",
  "topic": "arrays-and-hashing",
  "leetcodeUrl": "https://leetcode.com/problems/valid-sudoku/",
  "summary": "Decide whether a partially filled 9x9 board breaks any Sudoku rule. Only the filled cells are checked, and the board need not be solvable \u2014 a board with no contradictions among its current entries is valid. Empty cells are the string `\".\"`.",
  "approaches": [
    {
      "key": "three-pass",
      "name": "Rows, then columns, then boxes",
      "time": "O(1)",
      "space": "O(1)",
      "note": "Three independent sweeps, each building a fresh set per unit. The most readable version, and the board is a fixed 81 cells so the constant factor is the only thing that varies."
    },
    {
      "key": "single-pass",
      "name": "One pass, nine of each tracker",
      "time": "O(1)",
      "space": "O(1)",
      "default": true,
      "note": "Visit each cell once, updating its row, column and box tracker together. The box index is `(r // 3) * 3 + c // 3` \u2014 the one line in this problem worth deriving rather than memorising."
    }
  ],
