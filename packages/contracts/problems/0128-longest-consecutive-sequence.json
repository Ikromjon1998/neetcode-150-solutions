{
  "$schema": "../schema/problem-contract.schema.json",
  "id": 128,
  "slug": "longest-consecutive-sequence",
  "title": "Longest Consecutive Sequence",
  "difficulty": "medium",
  "topic": "arrays-and-hashing",
  "leetcodeUrl": "https://leetcode.com/problems/longest-consecutive-sequence/",
  "summary": "Return the length of the longest run of consecutive integers present in `nums`. The elements need not be adjacent in the array, and duplicates do not extend a run.",
  "approaches": [
    {
      "key": "sorting",
      "name": "Sort, then walk",
      "time": "O(n log n)",
      "space": "O(n)",
      "note": "Once sorted, a run is a stretch of neighbours differing by exactly one. Duplicates must be skipped rather than counted, which is the detail this approach gets wrong first."
    },
    {
      "key": "hash-set",
      "name": "Start only at run beginnings",
      "time": "O(n)",
      "space": "O(n)",
      "default": true,
      "note": "Put everything in a set, then walk a run only from a value whose predecessor is absent. That guard is what keeps it O(n) \u2014 without it the inner loop re-walks every run from every member and it degrades to O(n^2)."
    }
  ],
  "cases": [
    {
      "name": "textbook",
      "input": {
        "nums": [
          100,
          4,
          200,
          1,
          3,
          2
        ]
      },
      "expected": 4
    },
    {
      "name": "long run with a duplicate",
      "input": {
        "nums": [
          0,
          3,
          7,
          2,
          5,
          8,
          4,
          6,
          0,
          1
        ]
      },
      "expected": 9
    },
    {
      "name": "two runs, longer second",
      "input": {
        "nums": [
          9,
          1,
          4,
          7,
          3,
          -1,
          0,
          5,
          8,
          -1,
          6
        ]
      },
      "expected": 7
    },
    {
      "name": "empty",
      "input": {
        "nums": []
      },
      "expected": 0
    },
    {
      "name": "single element",
      "input": {
        "nums": [
          1
        ]
      },
      "expected": 1
    },
    {
      "name": "all duplicates",
      "input": {
        "nums": [
          5,
          5,
          5,
          5
        ]
      },
      "expected": 1
    },
    {
      "name": "crosses zero",
      "input": {
        "nums": [
          -1,
          0,
          1
        ]
      },
      "expected": 3
    },
    {
      "name": "no run longer than one",
      "input": {
        "nums": [
          10,
          30,
          20,
          40
        ]
      },
      "expected": 1
    },
    {
      "name": "duplicate inside a run",
      "input": {
        "nums": [
          1,
          2,
          0,
          1
        ]
      },
      "expected": 3
    }
  ],
  "validationCases": [
    {
      "name": "missing nums",
      "input": {},
      "status": 422
    },
    {
      "name": "nums is not a list",
      "input": {
        "nums": 5
      },
      "status": 422
    },
    {
      "name": "non-integer element",
      "input": {
        "nums": [
          1,
          "two"
        ]
      },
      "status": 422
    }
  ],
  "notFoundCases": []
}
